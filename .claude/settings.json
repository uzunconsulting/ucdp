{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "Set-ExecutionPolicy -Scope Process Bypass -Force; & (Join-Path $env:CLAUDE_PROJECT_DIR '.claude\\hooks\\uddp-session-start.ps1')",
            "timeout": 20,
            "statusMessage": "UDDP: aktuellen Stand laden"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "Set-ExecutionPolicy -Scope Process Bypass -Force; & (Join-Path $env:CLAUDE_PROJECT_DIR '.claude\\hooks\\uddp-guard.ps1')",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "Set-ExecutionPolicy -Scope Process Bypass -Force; & (Join-Path $env:CLAUDE_PROJECT_DIR '.claude\\hooks\\uddp-guard.ps1')",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "Set-ExecutionPolicy -Scope Process Bypass -Force; & (Join-Path $env:CLAUDE_PROJECT_DIR '.claude\\hooks\\uddp-overwrite-guard.ps1')",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "Set-ExecutionPolicy -Scope Process Bypass -Force; & (Join-Path $env:CLAUDE_PROJECT_DIR '.claude\\hooks\\uddp-postedit-nudge.ps1')",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "Set-ExecutionPolicy -Scope Process Bypass -Force; & (Join-Path $env:CLAUDE_PROJECT_DIR '.claude\\hooks\\uddp-doc-check.ps1')",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
